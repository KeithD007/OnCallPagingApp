<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On-Call Paging App"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a department to page:"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonCT"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page CT Technologist"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonCathLab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page Cath Lab Team"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonRadiologist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page Radiologist"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/buttonSupervisor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Page Supervisor"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonBackToLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Login" />

</LinearLayout>